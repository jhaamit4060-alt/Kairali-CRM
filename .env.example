# Application session signing
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes

# MySQL - never commit real credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kairali_crm
DB_USER=kairali_app
DB_PASSWORD=replace-me
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=30000

# Server-only KTAHV workflow integration
KTAHV_AUTH_SCRIPT_URL=https://script.google.com/macros/s/replace-me/exec
KTAHV_AUTH_SCRIPT_TOKEN=replace-with-integration-token
KTAHV_BOOKINGS_SCRIPT_URL=https://script.google.com/macros/s/replace-me/exec
KTAHV_BOOKINGS_SCRIPT_TOKEN=replace-with-integration-token
KTAHV_ARRIVAL_DEPARTURE_SCRIPT_URL=https://script.google.com/macros/s/replace-me/exec
KTAHV_ARRIVAL_DEPARTURE_SCRIPT_TOKEN=replace-with-integration-token
